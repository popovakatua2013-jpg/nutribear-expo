# Устойчивость установки зависимостей на EAS Build (этап Install
# dependencies): у npm по умолчанию только 2 коротких ретрая, и если
# реестр npm моргнёт, сборка падает целиком («Unknown error. See logs
# of the Install dependencies build phase» — две сборки 11.11 подряд).
# Локально эти настройки безвредны: audit/fund — только телеметрия.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
audit=false
fund=false
