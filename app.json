{
  "expo": {
    "name": "NutriBear",
    "slug": "nutribear",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutribear",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1020",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutribear.app",
      "buildNumber": "1",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.nutribear.app",
      "versionCode": 1,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1020"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1020"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Приложению нужна камера, чтобы распознавать еду по фото",
          "photoPermission": "Приложению нужен доступ к фото, чтобы распознавать еду по снимку"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Приложению нужен микрофон, чтобы распознавать еду по голосу"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
